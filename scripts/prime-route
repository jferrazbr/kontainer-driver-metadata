#!/usr/bin/env bash
# scripts/prime-route
#
# Inputs (required):
#   - CHANNELS_FILE: path to channels yaml (e.g. channels-rke2.yaml)
#   - SOME_K8S_VERSION: exact release version key (e.g. v1.31.14+rke2r1)
#   - LAST_COMMUNITY_RANCHER: cutoff Rancher version (e.g. v2.10.3)
#
# Inputs (required only when PRIME_MODE=1):
#   - STAGE_REGISTRY_ENDPOINT: prime registry host
#
# Sets:
#   - PRIME_MODE (0/1)
#   - PRIME_REG_HOST (when PRIME_MODE=1)

set -e

if ! printf '1.0.0\n' | sort -V >/dev/null 2>&1; then
  echo "ERROR: sort -V not supported on this system" >&2
  exit 1
fi

if [[ -z "${CHANNELS_FILE:-}" ]]; then
  echo "ERROR: CHANNELS_FILE is required" >&2
  exit 1
fi
if [[ ! -f "${CHANNELS_FILE}" ]]; then
  echo "ERROR: CHANNELS_FILE does not exist: ${CHANNELS_FILE}" >&2
  exit 1
fi

if [[ -z "${SOME_K8S_VERSION:-}" ]]; then
  echo "ERROR: SOME_K8S_VERSION is required (e.g. v1.31.14+rke2r1)" >&2
  exit 1
fi

if [[ -z "${LAST_COMMUNITY_RANCHER:-}" ]]; then
  echo "ERROR: LAST_COMMUNITY_RANCHER is required (e.g. v2.10.3)" >&2
  exit 1
fi

MINCHAN="$(
  yq e -r '
    .releases[]
    | select(.version == strenv(SOME_K8S_VERSION))
    | .minChannelServerVersion
  ' "${CHANNELS_FILE}" 2>/dev/null | tail -n1
)"

if [[ -z "${MINCHAN}" || "${MINCHAN}" == "null" ]]; then
  echo "ERROR: could not find minChannelServerVersion for SOME_K8S_VERSION=${SOME_K8S_VERSION} in ${CHANNELS_FILE}" >&2
  exit 1
fi

# Normalize versions:
# - drop leading v
# - drop suffix after numeric semver (alpha/rc/build)
minchan_norm="$(printf '%s' "${MINCHAN}" | sed -E 's/^v//' | sed -E 's/[^0-9.].*$//')"
community_norm="$(printf '%s' "${LAST_COMMUNITY_RANCHER}" | sed -E 's/^v//' | sed -E 's/[^0-9.].*$//')"

if [[ -z "${minchan_norm}" || -z "${community_norm}" ]]; then
  echo "ERROR: failed to normalize versions (MINCHAN=${MINCHAN}, LAST_COMMUNITY_RANCHER=${LAST_COMMUNITY_RANCHER})" >&2
  exit 1
fi

PRIME_MODE=0
unset PRIME_REGISTRY_ENVIRONMENT
unset PRIME_REG_HOST

# PRIME_MODE=1 if MINCHAN > LAST_COMMUNITY_RANCHER
if [[ "${minchan_norm}" != "${community_norm}" ]] && \
   [[ "$(printf '%s\n%s\n' "${minchan_norm}" "${community_norm}" | LC_ALL=C sort -V | tail -n1)" == "${minchan_norm}" ]]; then
  PRIME_MODE=1

  if [[ -z "${STAGE_REGISTRY_ENDPOINT:-}" ]]; then
    echo "ERROR: STAGE_REGISTRY_ENDPOINT is required when PRIME_MODE=1" >&2
    exit 1
  fi

  # avoid leaking host if xtrace is enabled
  _TRACE_WAS_ON=0
  if [[ $- == *x* ]]; then
    _TRACE_WAS_ON=1
    set +x
  fi

  PRIME_REG_HOST="${STAGE_REGISTRY_ENDPOINT}"
  export PRIME_REG_HOST

  if [[ "${_TRACE_WAS_ON}" == "1" ]]; then
    set -x
  fi
fi

export PRIME_MODE
